#!/usr/bin/env python3
"""AppSec CLI: straightforward real deployment, diagnostics and operations.

No demo mode, fixtures or fake data. Uses Docker Compose v2 and stdlib only.
"""
from __future__ import annotations

import argparse
import json
import re
import runpy
import time
import base64
import os
import secrets
import shutil
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent
ENV_FILE = ROOT / ".env"
ENV_TEMPLATE = ROOT / ".env.example"
COMPOSE_FILE = ROOT / "docker-compose.yaml"
SERVICE_CHOICES = (
    "postgres", "buildkit", "minio", "api", "nginx", "worker", "scheduler",
    "metabase", "image-worker", "security-worker", "mcp",
)
PASSWORD_KEYS = (
    "POSTGRES_PASSWORD", "APPSEC_ADMIN_API_KEY", "APPSEC_ADMIN_PASSWORD",
    "METABASE_ADMIN_PASSWORD",
    "MINIO_ROOT_PASSWORD", "S3_SECRET_ACCESS_KEY",
)


def run(*arguments: str) -> None:
    result = subprocess.run(arguments, cwd=ROOT, env={**os.environ, "PWD": str(ROOT)}, check=False)
    if result.returncode:
        raise RuntimeError(f"Command failed with exit code {result.returncode}: {arguments[0]}")


def compose_command(*args: str) -> list[str]:
    override = ROOT / "docker-compose.override.yaml"
    files = ["-f", str(COMPOSE_FILE)]
    if override.is_file():
        files.extend(["-f", str(override)])
    return ["docker", "compose", *files, *args]


def compose(*args: str) -> None:
    run(*compose_command(*args))


def read_env() -> dict[str, str]:
    if not ENV_FILE.exists():
        return {}
    settings = {}
    for line in ENV_FILE.read_text(encoding="utf-8").splitlines():
        if line and not line.lstrip().startswith("#") and "=" in line:
            key, value = line.split("=", 1)
            settings[key.strip()] = value.strip()
    return settings


def check_prerequisites() -> None:
    if not shutil.which("docker"):
        raise RuntimeError("Docker is not installed or not on PATH")
    run("docker", "compose", "version")
    run("docker", "info")


def setup(_args) -> None:
    if ENV_FILE.exists():
        print("Existing .env preserved. No values were overwritten.")
        print("Run './appsec doctor' to validate your deployment.")
        return
    if not ENV_TEMPLATE.exists():
        raise RuntimeError(".env.example is missing")
    values = {key: secrets.token_urlsafe(32) for key in PASSWORD_KEYS}
    # MinIO uses its root credentials for local S3 access until a dedicated
    # bucket-scoped service account is provisioned. Keep them consistent.
    values["S3_SECRET_ACCESS_KEY"] = values["MINIO_ROOT_PASSWORD"]
    # This local HTTP entrypoint is loopback-only by default. Set true behind HTTPS.
    values["APPSEC_SESSION_COOKIE_SECURE"] = "false"
    values["DOWNLOADS_REQUIRE_AUTH"] = "true"
    values["APPSEC_MFA_ENCRYPTION_KEY"] = base64.urlsafe_b64encode(secrets.token_bytes(32)).decode("ascii")
    template = ENV_TEMPLATE.read_text(encoding="utf-8")
    found = set()
    lines = []
    for line in template.splitlines():
        if "=" in line and not line.lstrip().startswith("#"):
            key, _ = line.split("=", 1)
            if key in values:
                line = key + "=" + values[key]
                found.add(key)
        lines.append(line)
    for key, value in values.items():
        if key not in found:
            lines.append(key + "=" + value)
    content = "\n".join(lines) + "\n"
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    descriptor = os.open(ENV_FILE, flags, 0o600)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            stream.write(content)
    except BaseException:
        ENV_FILE.unlink(missing_ok=True)
        raise
    print("Created .env with random local credentials (permissions: 0600).")
    print("Use './appsec start' to start AppSec, then open http://127.0.0.1:8080")
    print("Use './appsec credentials' on a trusted terminal to see the generated admin login.")
    print("For an HTTPS deployment, set APPSEC_SESSION_COOKIE_SECURE=true before use.")


def wizard(args) -> None:
    """Human-friendly full platform startup; publication still requires approval."""
    print("AppSec onboarding wizard — real services, no demo data", flush=True)
    check_prerequisites()
    if not ENV_FILE.exists():
        setup(args)
    else:
        print("Using existing .env; existing credentials remain untouched.")
    print("\nPlan: start PostgreSQL, MinIO, API, Workers, BuildKit and Metabase (full mode).")
    print("AppSec UI: http://127.0.0.1:8080; Metabase: http://127.0.0.1:3001")
    print("Patching is enabled; registry publication still requires explicit approval. MCP is optional.")
    if not args.yes:
        if not sys.stdin.isatty():
            raise RuntimeError("Interactive terminal required; use ./appsec wizard --yes to confirm startup")
        if input("Start the platform using this configuration? [y/N] ").strip().lower() != "y":
            print("No containers started. You can run ./appsec start later.")
            return
    start(argparse.Namespace(analytics=True))
    print("\nNext: open the Control Center and choose 'New manual scan'.")
    print("If something fails, run ./appsec doctor and ./appsec logs worker.")


def checkout_build_info() -> dict[str, str]:
    module = runpy.run_path(str(ROOT / "runner/appsecctl/build_info.py"))
    fingerprint = module["source_fingerprint"](ROOT / "runner/appsecctl", ROOT / "migrations")
    revision = "unknown"
    try:
        result = subprocess.run(["git", "rev-parse", "HEAD"], cwd=ROOT,
                                capture_output=True, text=True, check=True, timeout=10)
        candidate = result.stdout.strip()
        if re.fullmatch(r"[0-9a-f]{40}", candidate):
            revision = candidate
    except (OSError, subprocess.SubprocessError):
        pass
    return {"revision": revision, "source_sha256": fingerprint}


def runtime_builds() -> tuple[dict[str, str], dict[str, dict]]:
    expected = checkout_build_info()
    results = {}
    for service in ("api", "worker", "scheduler"):
        try:
            result = subprocess.run(compose_command("--profile", "platform", "exec", "-T", service,
                                    "python", "-m", "appsecctl.build_info"), cwd=ROOT,
                                    capture_output=True, text=True, check=True, timeout=20)
            results[service] = json.loads(result.stdout)
        except (OSError, ValueError, subprocess.SubprocessError):
            results[service] = {}
    return expected, results


def build_matches(expected, actual) -> bool:
    return bool(actual.get("source_sha256") == expected["source_sha256"] and
                (expected["revision"] == "unknown" or actual.get("revision") == expected["revision"]))


def verify_deployment() -> None:
    expected, results = runtime_builds()
    for service, actual in results.items():
        print(service + " build: " + str(actual.get("revision", "unavailable")) +
              " source=" + str(actual.get("source_sha256", "unavailable"))[:16], flush=True)
    mismatches = [service for service, actual in results.items() if not build_matches(expected, actual)]
    if mismatches:
        raise RuntimeError("Deployment source/revision mismatch: " + ", ".join(mismatches) +
                           ". Check Compose overrides and rebuild from this checkout.")
    # Nginx resolves its upstream at startup. Reload after the API is recreated.
    compose("--profile", "platform", "restart", "nginx")
    for attempt in range(10):
        try:
            req = urllib.request.Request("http://127.0.0.1:8080/appsec-api/ui/build-info",
                                         headers={"Cache-Control": "no-cache"})
            with urllib.request.urlopen(req, timeout=3) as response:
                actual = json.load(response)
            if build_matches(expected, actual):
                print("Verified browser endpoint build: " + expected["revision"][:12], flush=True)
                return
        except (OSError, ValueError):
            pass
        if attempt < 9:
            time.sleep(2)
    raise RuntimeError("Browser endpoint does not serve the verified deployment; check Nginx/port mapping.")


def verify_patch_runtime() -> None:
    for service in ("api", "worker"):
        result = subprocess.run(compose_command("--profile", "platform", "exec", "-T", service,
                                "python", "-c", "import os; print(os.getenv('APPSEC_PATCH_ENABLED',''))"),
                                cwd=ROOT, capture_output=True, text=True, check=True, timeout=20)
        if result.stdout.strip().lower() not in ("true", "1", "yes"):
            raise RuntimeError("Full mode required: patching disabled in " + service + "; check Compose overrides")
    compose("--profile", "patch", "exec", "-T", "buildkit",
            "buildctl", "--addr", "unix:///run/buildkit/buildkitd.sock", "debug", "workers")
    print("Full patch runtime verified.", flush=True)


def start(args) -> None:
    if not ENV_FILE.exists():
        raise RuntimeError(".env missing. Run './appsec setup' first.")
    check_prerequisites()
    expected = checkout_build_info()
    os.environ["APPSEC_BUILD_REVISION"] = expected["revision"]
    print("Deploying checkout " + expected["revision"][:12] + " source=" + expected["source_sha256"][:16], flush=True)
    print("\n[1/3] Starting database and artifact storage", flush=True)
    compose("--profile", "platform", "up", "-d", "postgres", "minio", "minio-init")
    compose("--profile", "patch", "up", "-d", "--wait", "buildkit")
    print("\n[2/3] Building shared AppSec runtime image and applying database migrations", flush=True)
    # A cached runner may contain older Alembic revisions than the checkout.
    # Always build from the current source before executing database migrations.
    compose("--profile", "tools", "build", "appsec-runner")
    compose("--profile", "tools", "run", "--rm", "appsec-runner", "migrate")
    print("\n[3/3] Starting Control Center, workers and Metabase", flush=True)
    os.environ["APPSEC_PATCH_ENABLED"] = "true"
    services = ["api", "nginx", "worker", "scheduler", "metabase-db-init", "metabase"]
    # All first-party execution roles use the exact image built above.
    # No implicit remote pull or second build for these roles.
    compose("--profile", "platform", "up", "-d", "--no-build", *services)
    verify_deployment()
    verify_patch_runtime()
    run("bash", str(ROOT / "scripts/setup-metabase.sh"))
    print("\nAppSec Control Center: http://127.0.0.1:8080")
    print("Sign-in: admin (use './appsec credentials' to retrieve the generated password).")
    print("Metabase dashboards: http://127.0.0.1:3001")
    print("MCP is OFF unless separately activated with 'make mcp-up'.")
    print("Patching: enabled — local patch and rescan; registry publication requires separate approval.")


def stop(_args) -> None:
    check_prerequisites()
    compose("--profile", "platform", "--profile", "patch", "--profile", "mcp", "--profile", "ai", "stop")
    print("AppSec containers stopped. Named data volumes are preserved.")


def status(_args) -> None:
    check_prerequisites()
    compose("--profile", "platform", "--profile", "patch", "--profile", "mcp", "--profile", "ai", "ps")


def logs(args) -> None:
    if args.service not in SERVICE_CHOICES:
        raise RuntimeError("Unknown service; use one of: " + ", ".join(SERVICE_CHOICES))
    check_prerequisites()
    compose("--profile", "platform", "--profile", "patch", "--profile", "mcp", "logs", "-f", "--tail", "80", args.service)


def doctor(_args) -> None:
    failures = 0
    warnings = 0

    def show(label: str, status: str, reason: str = ""):
        nonlocal failures, warnings
        print(f"[{status:4}] {label}" + (f" — {reason}" if reason else ""))
        if status == "FAIL":
            failures += 1
        if status == "WARN":
            warnings += 1

    if not ENV_FILE.exists():
        show("Configuration", "FAIL", "Missing .env; run ./appsec setup")
    else:
        settings = read_env()
        show("Configuration", "OK", ".env present")
        for key in PASSWORD_KEYS:
            val = settings.get(key, "")
            if not val:
                show(key, "FAIL", "Credential is missing")
            elif val.startswith(("appsec-", "change-this", "Change-This")) or len(val) < 20:
                show(key, "WARN", "Check that you replaced example credentials")
        if os.name != "nt" and (ENV_FILE.stat().st_mode & 0o077):
            show(".env file permissions", "WARN", "Run chmod 600 .env")
        if not settings.get("APPSEC_MFA_ENCRYPTION_KEY"):
            show("MFA encryption", "WARN", "Not configured. To offer authenticator MFA, provision a 32-byte Fernet key in .env")
        else:
            show("MFA encryption", "OK", "Key configured; retain it for backup/restore")
        if settings.get("APPSEC_SESSION_COOKIE_SECURE") == "false":
            show("Session cookies", "WARN", "HTTP localhost only; enable Secure behind HTTPS")
        if settings.get("MINIO_ROOT_PASSWORD") != settings.get("S3_SECRET_ACCESS_KEY"):
            show("MinIO credentials", "WARN", "Local S3 access requires matching credentials or a dedicated service account")
        show("Patch executor", "WARN", "Privileged BuildKit must run on isolated hosts")
    if not shutil.which("docker"):
        show("Docker CLI", "FAIL", "Install Docker Engine with Compose v2")
    else:
        for name, arguments in [
            ("Docker daemon", ["docker", "info"]),
            ("Docker Compose v2", ["docker", "compose", "version"]),
            ("Compose configuration", compose_command("config", "-q")),
        ]:
            try:
                result = subprocess.run(arguments, cwd=ROOT, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=20, check=False)
                show(name, "OK" if result.returncode == 0 else "FAIL", "" if result.returncode == 0 else "Check Docker or configuration")
            except (OSError, subprocess.TimeoutExpired):
                show(name, "FAIL", "Cannot execute check")
    try:
        proc = subprocess.run(
            compose_command("--profile", "platform", "--profile", "patch", "--profile", "mcp", "ps", "--format", "json"),
            cwd=ROOT, capture_output=True, text=True, timeout=20, check=False,
        )
        if proc.returncode == 0:
            import json
            raw = proc.stdout.strip()
            if raw:
                entries = json.loads(raw) if raw.startswith("[") else [json.loads(line) for line in raw.splitlines()]
                by_service = {entry.get("Service", ""): entry for entry in entries}
                for name in ("postgres", "api", "nginx", "worker", "scheduler", "metabase", "minio", "buildkit"):
                    entry = by_service.get(name)
                    status = str(entry.get("State", "")) if entry else ""
                    health = str(entry.get("Health", "")) if entry else ""
                    healthy = status == "running" and health not in ("unhealthy", "starting")
                    # A restarting/stopped required worker is an operational failure,
                    # even when the API and database are responding.
                    result = "OK" if healthy else ("WARN" if status == "running" and health == "starting" else "FAIL")
                    show("Container " + name, result,
                         (status + (" / " + health if health else "")) if entry else "not started")
    except (OSError, ValueError, subprocess.TimeoutExpired):
        show("Container diagnostics", "WARN", "Could not parse Compose status")

    try:
        with urllib.request.urlopen("http://127.0.0.1:3001/api/health", timeout=5) as response:
            show("Metabase analytics", "OK" if response.status == 200 else "FAIL")
    except (urllib.error.URLError, TimeoutError):
        show("Metabase analytics", "FAIL", "Metabase is not reachable on localhost:3001")

    try:
        with urllib.request.urlopen("http://127.0.0.1:8080/appsec-api/health", timeout=5) as response:
            payload = response.read(1024)
        show("AppSec API + Postgres", "OK" if b'"ok"' in payload else "FAIL")
    except (urllib.error.URLError, TimeoutError):
        show("AppSec API + Postgres", "FAIL", "Control Center not reachable on 127.0.0.1:8080")
    try:
        expected, results = runtime_builds()
        for service, actual in results.items():
            matched = build_matches(expected, actual)
            show("Deployment " + service, "OK" if matched else "FAIL",
                 "checkout=" + expected["revision"][:12] + " runtime=" + str(actual.get("revision", "unknown"))[:12] +
                 " source=" + str(actual.get("source_sha256", "unavailable"))[:16])
        with urllib.request.urlopen("http://127.0.0.1:8080/appsec-api/ui/build-info", timeout=5) as response:
            actual = json.load(response)
        show("Browser endpoint build", "OK" if build_matches(expected, actual) else "FAIL",
             "runtime=" + str(actual.get("revision", "unknown"))[:12])
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError):
        show("Deployment identity", "FAIL", "Could not verify checkout and running browser endpoint")
    try:
        verify_patch_runtime()
        show("Full patch runtime", "OK")
    except (OSError, RuntimeError, subprocess.SubprocessError):
        show("Full patch runtime", "FAIL", "API/worker patch flag or BuildKit unavailable")
    print(f"\nDoctor result: {failures} failures, {warnings} warnings.")
    if failures:
        raise RuntimeError("Fix FAIL checks before using AppSec")


def credentials(_args) -> None:
    if not sys.stdin.isatty():
        raise RuntimeError("Credential display requires an interactive trusted terminal")
    settings = read_env()
    if not settings:
        raise RuntimeError("Run './appsec setup' first")
    if input("Display the local admin password in this terminal? [y/N] ").strip().lower() != "y":
        return
    print("Username: admin")
    print("Password:", settings.get("APPSEC_ADMIN_PASSWORD", "not set"))
    print("Metabase URL: http://127.0.0.1:3001")
    print("Metabase username:", settings.get("METABASE_ADMIN_EMAIL", "admin@appsec.local"))
    print("Metabase password:", settings.get("METABASE_ADMIN_PASSWORD", "not set"))
    print("Never share this password or commit .env to Git.")


def main() -> int:
    parser = argparse.ArgumentParser(prog="appsec", description="AppSec Control Center command line")
    sub = parser.add_subparsers(dest="command", required=True)
    for name in ("setup", "stop", "status", "doctor", "credentials"):
        sub.add_parser(name)
    wizard_parser = sub.add_parser("wizard", help="Guided first run: checks, secure config and full startup")
    wizard_parser.add_argument("--yes", action="store_true", help="Confirm full startup for unattended setup")
    start_parser = sub.add_parser("start", help="Start real AppSec services and migrate the DB")
    start_parser.add_argument("--analytics", action="store_true", help="Legacy compatibility; Metabase is enabled by default")
    start_parser.add_argument("--patching", action="store_true", help="Compatibility flag; full patch mode is always enabled")
    logs_parser = sub.add_parser("logs")
    logs_parser.add_argument("service", choices=SERVICE_CHOICES)
    args = parser.parse_args()
    commands = {
        "setup": setup, "wizard": wizard, "start": start, "stop": stop,
        "status": status, "doctor": doctor, "credentials": credentials, "logs": logs,
    }
    try:
        commands[args.command](args)
        return 0
    except (RuntimeError, OSError, subprocess.SubprocessError) as exc:
        print("ERROR:", exc, file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
