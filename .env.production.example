POSTGRES_DB=appsec
POSTGRES_USER=appsec
POSTGRES_PASSWORD=change-this-long-random-postgres-password
POSTGRES_PASSWORD_FILE=

APPSEC_ADMIN_API_KEY=change-this-long-random-api-key
APPSEC_ADMIN_API_KEY_FILE=
APPSEC_ADMIN_PASSWORD=change-this-admin-password
APPSEC_ADMIN_PASSWORD_FILE=


METABASE_IMAGE=metabase/metabase:v0.63.19
METABASE_DB_NAME=metabase
METABASE_ADMIN_EMAIL=admin@appsec.example.com
METABASE_ADMIN_PASSWORD=Change-This-Metabase-Password-2026!
METABASE_SITE_NAME="AppSec Analytics"

TRIVY_IMAGE=aquasec/trivy:latest
TRIVY_DB_REPOSITORY=ghcr.io/aquasecurity/trivy-db:2
TRIVY_JAVA_DB_REPOSITORY=ghcr.io/aquasecurity/trivy-java-db:1
TRIVY_DB_UPDATE_INTERVAL_SECONDS=21600
GITLEAKS_IMAGE=zricethezav/gitleaks:latest

COPA_VERSION=0.14.1
COPA_TIMEOUT=30m
BUILDKIT_CONTAINER=appsec-buildkit

REGISTRY_HOST=harbor.example.com
REGISTRY_EXTERNAL_URL=harbor.example.com
PATCHED_REPOSITORY=library/appsec-patched

POLICY_MAX_CRITICAL=0
POLICY_MAX_HIGH=0
POLICY_MAX_MEDIUM=999999
POLICY_MAX_LOW=999999
POLICY_MAX_UNKNOWN=0

WORKER_POLL_SECONDS=5
WORKER_QUEUES=image,security
SCHEDULER_POLL_SECONDS=60
RETENTION_DAYS=30
CI_MAX_HIGH=0

NOTIFY_WEBHOOK_URL=
NOTIFY_TIMEOUT_SECONDS=5

ARTIFACT_STORAGE=s3
ARTIFACT_UPLOAD_STRICT=false
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=https://appsec-artifacts.example.com
S3_REGION=us-east-1
S3_BUCKET=appsec-artifacts
S3_ACCESS_KEY_ID=change-this-s3-access-key
S3_SECRET_ACCESS_KEY=change-this-s3-secret-key
S3_ACCESS_KEY_ID_FILE=
S3_SECRET_ACCESS_KEY_FILE=
MINIO_ROOT_USER=change-this-minio-user
MINIO_ROOT_PASSWORD=change-this-minio-password

REPORTS_VOLUME=appsec_reports
# TRIVY_CACHE_PATH=/absolute/path/to/trivy-cache
WORKSPACES_VOLUME=appsec_workspaces
TOOL_NETWORK=appsec-net
DOWNLOADS_REQUIRE_AUTH=true
APPSEC_SESSION_COOKIE_SECURE=true
SECURITY_ALLOWED_GIT_HOSTS=github.com,gitlab.com
# Add your trusted self-hosted Git domain if needed; never allow arbitrary scan targets.

# Optional MCP (disabled unless explicitly launched); dedicated read-only DB role REQUIRED for production.
APPSEC_MCP_HOST_PORT=8091
# APPSEC_MCP_DATABASE_URL=postgresql://appsec_mcp:URL_ENCODED_PASSWORD@postgres:5432/appsec

# Full mode always enables patching; isolate the privileged executor.
APPSEC_PATCH_ENABLED=true

# Separation of duties for production publication.
APPSEC_REQUIRE_SECOND_APPROVER=true

# Persist this encryption key securely across rollouts, backups and restores.
APPSEC_MFA_ENCRYPTION_KEY=

# Require an enabled approved runtime registry even if the source list is empty.
APPSEC_REQUIRE_IMAGE_SOURCES=false
# Optional bootstrap registry overrides (not database-backed).
# POSTGRES_IMAGE=registry.example/library/postgres:16-alpine
# MINIO_IMAGE=registry.example/minio/minio:RELEASE.2025-04-22T22-12-26Z
# MINIO_MC_IMAGE=registry.example/minio/mc:RELEASE.2025-04-16T18-13-26Z
# NGINX_IMAGE=registry.example/library/nginx:1.27-alpine
# BUILDKIT_IMAGE=registry.example/moby/buildkit:latest
# RUNNER_BASE_IMAGE=registry.example/library/python:3.12-slim
# APPSEC_PIP_INDEX_URL=https://pypi.org/simple

# Optional runner Debian archive mirror base, without /debian or /debian-security.
# APPSEC_DEBIAN_MIRROR=https://mirrors.example.org
# Java DB is large; opt in to explicit ordered prefetch for Java analysis.
APPSEC_PREFETCH_JAVA_DB=false

APPSEC_TRIVY_DB_TIMEOUT_SECONDS=180
APPSEC_TRIVY_SCAN_TIMEOUT_SECONDS=900
APPSEC_SBOM_TIMEOUT_SECONDS=600
# APPSEC_TOOL_HTTPS_PROXY=http://proxy.example:3128
# APPSEC_TOOL_CA_FILE=/path/inside/scheduler/company-ca.pem
